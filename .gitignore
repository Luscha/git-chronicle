# Byte-compiled / packaging
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
wheels/

# Virtual environments
.venv/
venv/

# Secrets and machine-specific config — copy config.example.toml -> config.toml
.env
config.toml

# Runtime artifacts (databases + exported graphs/JSON). Default output goes to build/.
*.db
*.db-shm
*.db-wal
graph.html
domains.json
features.json

.serena
.claude

# eval answers are regenerated output
eval/*.result.json

# your own curation lives at the repo root, not in this repository
/gitchronicle.plan
/gitchronicle.md

# local model/provider cache and scratch
.pytest_cache/

# a real curation and eval set of a private repository stay out of the public one
/eval/void-queue.json
/examples/void-queue.*
